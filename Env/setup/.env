# Mobius Injection Research Project - API Keys
# Copy this to .env in the scripts/setup directory

# === Anthropic API ===
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# === OpenAI API ===
OPENAI_API_KEY=sk-your-openai-key

# === OpenRouter API (Recommended - unified access to 200+ models) ===
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === xAI / Grok ===
GROK_API_KEY=your-grok-api-key
XAI_API_KEY=your-xai-api-key

# === Other Providers ===
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
DEEPSEEK_API_KEY=your-deepseek-key
FACTORY_API_KEY=your-factory-api-key

# === Base URLs ===
ANTHROPIC_BASE_URL=https://api.anthropic.com
# For Chinese API providers, you might use:
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# === Azure OpenAI ===
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://YOUR_PROJECT_NAME.openai.azure.com/openai